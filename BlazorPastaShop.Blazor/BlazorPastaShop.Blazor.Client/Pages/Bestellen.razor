@rendermode InteractiveAuto
@page "/bestellen"
@using BlazorPastaShop.Blazor.Client.Models
@inject Blazored.SessionStorage.ISessionStorageService sessionStore

<h3>Bestelling plaatsen</h3>

<EditForm FormName="bestelForm" Model="bestelling" OnValidSubmit="VoegBestellingToe">
    <div class="mb-3">
        <label>Pasta:</label>
        <InputSelect @bind-value="bestelling.Pasta" >
            @foreach (var soort in Enum.GetValues<Pasta>())
            {
                <option value="@soort">@soort.ToString()</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Grootte:</label>
        <InputSelect @bind-value="bestelling.Grootte">
            @foreach (var grootte in Enum.GetValues<Grootte>())
            {
                <option value="@grootte">@grootte</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Saus:</label>
        <InputSelect @bind-value="bestelling.Saus">
            @foreach (var saus in Enum.GetValues<GekozenSaus>())
            {
                <option value="@saus">@saus</option>
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Voeg bestelling toe</button>
</EditForm>

<p class="mt-3">Aantal bestellingen in winkelmandje: @aantalBestellingen</p>

@if (!string.IsNullOrEmpty(melding))
{
    <div class="alert alert-success mt-2">@melding</div>
}

@code {
    private BestellingModel bestelling = new BestellingModel();
    private List<BestellingModel> bestellingenInWinkelkar = new List<BestellingModel> ();
    private string? melding;
    private int aantalBestellingen => bestellingenInWinkelkar?.Count ?? 0;
   

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var opgeslagen = await sessionStore.GetItemAsync<List<BestellingModel>>("bestellingen");
            if (opgeslagen != null)
                bestellingenInWinkelkar = opgeslagen;
            

            StateHasChanged();
        }
        
    }

    private async Task VoegBestellingToe()
    {
        
        bestellingenInWinkelkar.Add(bestelling);
        await sessionStore.SetItemAsync("bestellingen", bestellingenInWinkelkar);

        melding = $"✅ Bestelling toegevoegd! ({aantalBestellingen} in mandje)";
        bestelling = new BestellingModel();
      //  StateHasChanged();
    }
}